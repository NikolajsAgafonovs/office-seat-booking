{
  "name": "@seat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API implementing docs/api.md and the invariants in docs/domain-model.md (decision 0006).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "@seat/shared": "*",
    "fastify": "^5.12.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.23.0"
  }
}
