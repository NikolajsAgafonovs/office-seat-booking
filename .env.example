# Copy to server/.env (or export in the shell). All values here are development defaults.

# Server port
PORT=3000

# Database (decision 0008). SQLite file for local work; PostgreSQL in deployed environments.
DATABASE_URL="file:./dev.db"

# Identity (decision 0007). "dev" offers a fixture-user picker; "oidc" is not wired yet.
AUTH_MODE=dev

# Admin role (decision 0004, open): comma-separated user ids.
ADMIN_USERS=carol

# Read-only users (R-25): comma-separated user ids. Everyone else can write.
READONLY_USERS=dan

# Office time zone for calendar dates (R-30). IANA name.
OFFICE_TZ=Europe/Riga

# Where the floor plan lives (docs/floor-plan.json is the source of truth, C-2).
FLOOR_PLAN_PATH=../docs/floor-plan.json
